{
  "name": "myspace-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' pnpm -r --parallel dev",
    "dev:web": "NODE_OPTIONS='--max-old-space-size=4096' pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:all": "NODE_OPTIONS='--max-old-space-size=4096' pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
