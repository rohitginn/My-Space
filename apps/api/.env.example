# Server
NODE_ENV=development
PORT=5000

# Database (Docker Postgres)
DATABASE_URL=postgres://myspace_user:myspace_pass@localhost:5432/myspace_db

# JWT
JWT_ACCESS_SECRET=your-access-secret-min-64-chars-change-me-in-env-files
JWT_REFRESH_SECRET=your-refresh-secret-min-64-chars-change-me-in-env-files
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000

# Generate with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
